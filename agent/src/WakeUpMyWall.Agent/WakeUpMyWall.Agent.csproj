<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      双目标：net10.0 给开发机 / CI（合成指标，契约照样能端到端验），
      net10.0-windows 给真实 PC（LibreHardwareMonitor 只带 win-* 运行时资产，引用不了别的目标）。
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WakeUpMyWall.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- 没有 LibreHardwareMonitor 的目标上，Windows 专属的适配层不参与编译。 -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Metrics/Windows/**/*.cs" />
  </ItemGroup>

</Project>
