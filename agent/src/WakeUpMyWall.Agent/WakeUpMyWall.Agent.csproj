<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      双目标：net10.0 给开发机 / CI（合成指标，契约照样能端到端验），
      net10.0-windows 给真实 PC（LibreHardwareMonitor 只带 win-* 运行时资产，引用不了别的目标）。
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <!-- 版本号是**发布产物名与 /api/v1/status 的对齐点**：改这里，Agent 自报的版本跟着变（见 StatusEndpoints）。 -->
    <Version>0.4.4</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WakeUpMyWall.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- WMI：读物理核心数（LHM 的核心数依赖 MSR，没有管理员权限时拿不到）。 -->
    <PackageReference Include="System.Management" Version="10.0.2" />
    <!-- 装成 Windows 服务时必须真的向 SCM 报到（否则 sc.exe 启动会报 1053），这由 UseWindowsService 负责。 -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- 允许在 Linux 上交叉构建 Windows 目标（WinForms 需要 Windows 桌面引用包）。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WinExe：双击 exe 不该弹控制台黑框；托盘图标就是全部 UI。 -->
    <OutputType>WinExe</OutputType>
    <!-- 托盘图标（无窗口 UI）：WinForms 的 NotifyIcon 比手写 Shell_NotifyIcon 稳得多。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- exe 自带图标，桌面/开始菜单快捷方式直接取它。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- 托盘图标的亮/暗两版打进程序集：运行时不依赖安装目录里的文件。 -->
    <EmbeddedResource Include="Assets\tray_bright.ico" />
    <EmbeddedResource Include="Assets\tray_dark.ico" />
  </ItemGroup>

  <!-- 没有 LibreHardwareMonitor 与 WinForms 的目标上，Windows 专属的实现不参与编译。 -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Metrics/Windows/**/*.cs" />
    <Compile Remove="Tray/TrayIconHost.cs" />
  </ItemGroup>

</Project>
